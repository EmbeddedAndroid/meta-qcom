From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Ravi Hothi <ravi.hothi@oss.qualcomm.com>
Date: Wed, 18 Nov 2026 18:03:42 +0530
Subject: [PATCH] FROMLIST: ucm2: Qualcomm: add Eliza CQS EVK support

The Eliza CQS EVK exposes a WSA884x two-speaker playback path and VA
DMIC capture. Add a HiFi profile covering speaker playback and internal
microphones.

Signed-off-by: Ravi Hothi <ravi.hothi@oss.qualcomm.com>
Signed-off-by: Tyler Baker <tyler.baker@oss.qualcomm.com>
Upstream-Status: Submitted [https://github.com/alsa-project/alsa-ucm-conf/pull/918]
---
 ucm2/Qualcomm/eliza/eliza-cqs-evk/HiFi.conf   | 51 +++++++++++++++++++
 .../eliza/eliza-cqs-evk/eliza-cqs-evk.conf    | 16 ++++++
 ucm2/conf.d/eliza/eliza-cqs-evk.conf          |  1 +
 3 files changed, 68 insertions(+)
 create mode 100644 ucm2/Qualcomm/eliza/eliza-cqs-evk/HiFi.conf
 create mode 100644 ucm2/Qualcomm/eliza/eliza-cqs-evk/eliza-cqs-evk.conf
 create mode 120000 ucm2/conf.d/eliza/eliza-cqs-evk.conf

diff --git a/ucm2/Qualcomm/eliza/eliza-cqs-evk/HiFi.conf b/ucm2/Qualcomm/eliza/eliza-cqs-evk/HiFi.conf
new file mode 100644
index 0000000..509cfe7
--- /dev/null
+++ b/ucm2/Qualcomm/eliza/eliza-cqs-evk/HiFi.conf
@@ -0,0 +1,51 @@
+SectionVerb {
+	EnableSequence [
+		cset "name='WSA_CODEC_DMA_RX_0 Audio Mixer MultiMedia1' 1"
+		cset "name='MultiMedia3 Mixer VA_CODEC_DMA_TX_0' 1"
+	]
+
+	Include.wsae.File "/codecs/wsa884x/two-speakers/DefaultEnableSeq.conf"
+
+	Value {
+		TQ "HiFi"
+	}
+}
+
+SectionDevice."Speaker" {
+	Comment "Speaker playback"
+
+	EnableSequence [
+		cset "name='WSA_COMP1 Switch' 1"
+		cset "name='WSA_COMP2 Switch' 1"
+	]
+
+	Include.wsamspke.File "/codecs/qcom-lpass/wsa-macro/SpeakerEnableSeq.conf"
+	Include.wsamspkd.File "/codecs/qcom-lpass/wsa-macro/SpeakerDisableSeq.conf"
+	Include.wsaspke.File "/codecs/wsa884x/two-speakers/SpeakerSeq.conf"
+
+	DisableSequence [
+		cset "name='WSA_COMP1 Switch' 0"
+		cset "name='WSA_COMP2 Switch' 0"
+	]
+
+	Value {
+		PlaybackChannels 2
+		PlaybackPriority 100
+		PlaybackPCM "hw:${CardId},0"
+		PlaybackMixer "default:${CardId}"
+	}
+}
+
+SectionDevice."Mic" {
+	Comment "Internal microphones"
+
+	Include.vadm0e.File "/codecs/qcom-lpass/va-macro/DMIC0EnableSeq.conf"
+	Include.vadm0d.File "/codecs/qcom-lpass/va-macro/DMIC0DisableSeq.conf"
+	Include.vadm1e.File "/codecs/qcom-lpass/va-macro/DMIC1EnableSeq.conf"
+	Include.vadm1d.File "/codecs/qcom-lpass/va-macro/DMIC1DisableSeq.conf"
+
+	Value {
+		CapturePriority 100
+		CapturePCM "hw:${CardId},2"
+	}
+}
diff --git a/ucm2/Qualcomm/eliza/eliza-cqs-evk/eliza-cqs-evk.conf b/ucm2/Qualcomm/eliza/eliza-cqs-evk/eliza-cqs-evk.conf
new file mode 100644
index 0000000..2e24ba1
--- /dev/null
+++ b/ucm2/Qualcomm/eliza/eliza-cqs-evk/eliza-cqs-evk.conf
@@ -0,0 +1,16 @@
+Syntax 4
+
+SectionUseCase."HiFi" {
+	File "/Qualcomm/eliza/eliza-cqs-evk/HiFi.conf"
+	Comment "HiFi quality Music."
+}
+
+BootSequence [
+	cset "name='SpkrLeft PA Volume' 12"
+	cset "name='SpkrRight PA Volume' 12"
+]
+
+Include.card-init.File "/lib/card-init.conf"
+Include.ctl-remap.File "/lib/ctl-remap.conf"
+Include.wsa-init.File "/codecs/wsa884x/two-speakers/init.conf"
+Include.wsam-init.File "/codecs/qcom-lpass/wsa-macro/init.conf"
diff --git a/ucm2/conf.d/eliza/eliza-cqs-evk.conf b/ucm2/conf.d/eliza/eliza-cqs-evk.conf
new file mode 120000
index 0000000..ec4876e
--- /dev/null
+++ b/ucm2/conf.d/eliza/eliza-cqs-evk.conf
@@ -0,0 +1 @@
+../../Qualcomm/eliza/eliza-cqs-evk/eliza-cqs-evk.conf
\ No newline at end of file
-- 
2.53.0

