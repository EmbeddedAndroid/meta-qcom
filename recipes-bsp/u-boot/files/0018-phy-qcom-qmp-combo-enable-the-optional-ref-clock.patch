From 0e192af5f0faa18810d8476c575b1e4f0c37b7a4 Mon Sep 17 00:00:00 2001
From: Tyler Baker <tyler.baker@oss.qualcomm.com>
Date: Fri, 20 Nov 2026 03:17:28 -0800
Subject: [PATCH 18/23] phy: qcom: qmp-combo: enable the optional ref clock

The combo PHY bindings list a "ref" clock next to "aux" and "com_aux",
but the driver never requests it, so it relies on the reference clock
being on already. On Eliza it is the TCSR USB 3 clkref gate, which
U-Boot otherwise never touches.

Get "ref" as an optional clock and enable it with the other clocks.

Signed-off-by: Tyler Baker <tyler.baker@oss.qualcomm.com>
Upstream-Status: Pending
---
 drivers/phy/qcom/phy-qcom-qmp-combo.c | 21 +++++++++++++++++++++
 1 file changed, 21 insertions(+)

diff --git a/drivers/phy/qcom/phy-qcom-qmp-combo.c b/drivers/phy/qcom/phy-qcom-qmp-combo.c
index dadb722799..93c276814f 100644
--- a/drivers/phy/qcom/phy-qcom-qmp-combo.c
+++ b/drivers/phy/qcom/phy-qcom-qmp-combo.c
@@ -253,6 +253,7 @@ struct qmp_combo {
 	void __iomem *pcs_usb;
 	void __iomem *pcs_misc;
 	struct clk *clks;
+	struct clk *ref_clk;
 	struct clk *pipe_clk;
 	int num_clks;
 	struct reset_ctl_bulk resets;
@@ -291,6 +292,8 @@ static int qmp_combo_com_exit(struct qmp_combo *qmp)
 {
 	int i;
 
+	clk_disable(qmp->ref_clk);
+
 	for (i = 0; i < qmp->num_clks; i++)
 		clk_disable(&qmp->clks[i]);
 
@@ -348,6 +351,17 @@ static int qmp_combo_com_init(struct qmp_combo *qmp)
 		}
 	}
 
+	ret = clk_enable(qmp->ref_clk);
+	if (ret) {
+		printf("Failed to enable ref clock: %d\n", ret);
+		for (i = qmp->num_clks - 1; i >= 0; i--)
+			clk_disable(&qmp->clks[i]);
+		for (i = qmp->num_vregs - 1; i >= 0; i--)
+			regulator_set_enable(qmp->vregs[i], false);
+		reset_assert_bulk(&qmp->resets);
+		return ret;
+	}
+
 	/* Common block register writes */
 	qphy_setbits(com, QPHY_V3_DP_COM_POWER_DOWN_CTRL, SW_PWRDN);
 	qphy_setbits(com, QPHY_V3_DP_COM_RESET_OVRD_CTRL,
@@ -603,6 +617,13 @@ static int qmp_combo_parse_dt(struct qmp_combo *qmp)
 	if (ret)
 		return ret;
 
+	qmp->ref_clk = devm_clk_get_optional(dev, "ref");
+	if (IS_ERR(qmp->ref_clk)) {
+		ret = PTR_ERR(qmp->ref_clk);
+		dev_err(dev, "failed to get ref clock: %d\n", ret);
+		return ret;
+	}
+
 	qmp->pipe_clk = devm_clk_get(dev, "usb3_pipe");
 	if (IS_ERR(qmp->pipe_clk)) {
 		dev_err(dev, "failed to get pipe clock (%ld)\n",
-- 
2.43.0

