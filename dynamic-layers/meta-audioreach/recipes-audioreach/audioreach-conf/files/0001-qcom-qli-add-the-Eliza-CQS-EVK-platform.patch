From 5e49e37886cfb5363aaddf14e473d67f58484b8f Mon Sep 17 00:00:00 2001
From: Tyler Baker <tyler.baker@oss.qualcomm.com>
Date: Sun, 8 Nov 2026 00:54:31 +0000
Subject: [PATCH] qcom: qli: add the Eliza CQS EVK platform

AGM finds no ACDB for "eliza-cqs-evk", so every graph open fails. Add
qcom/qli/eliza with SM8750's card and ACDB until there is an Eliza
ACDB: same LPASS and backends, SM8750's tuning.

Signed-off-by: Tyler Baker <tyler.baker@oss.qualcomm.com>
Upstream-Status: Submitted [https://github.com/AudioReach/audioreach-conf/pull/121]
---
 qcom/Makefile.am                              |   2 +-
 qcom/qli/configure.ac                         |   3 +-
 qcom/qli/eliza/Makefile.am                    |  16 +
 qcom/qli/eliza/acdbdata/acdb_cal.acdb         | Bin 0 -> 154426 bytes
 qcom/qli/eliza/acdbdata/workspaceFileXml.qwsp | Bin 0 -> 93136 bytes
 qcom/qli/eliza/card-defs.xml                  | 273 ++++++++++++++++++
 qcom/qli/eliza/config.pc.in                   |  10 +
 7 files changed, 302 insertions(+), 2 deletions(-)
 create mode 100644 qcom/qli/eliza/Makefile.am
 create mode 100644 qcom/qli/eliza/acdbdata/acdb_cal.acdb
 create mode 100644 qcom/qli/eliza/acdbdata/workspaceFileXml.qwsp
 create mode 100644 qcom/qli/eliza/card-defs.xml
 create mode 100644 qcom/qli/eliza/config.pc.in

diff --git a/qcom/Makefile.am b/qcom/Makefile.am
index 272bf8a..32cae6e 100644
--- a/qcom/Makefile.am
+++ b/qcom/Makefile.am
@@ -7,4 +7,4 @@ pkgconfigdir = $(libdir)/pkgconfig
 pkgconfig_DATA = kvh2xml.pc
 EXTRA_DIST = $(pkgconfig_DATA)
 
-SUBDIRS = qli/qcm6490 qli/qcs615 qli/qcs8275 qli/qcs8300 qli/qcs9100 qli/qcs9075 qli/sm8750 qli/GLYMUR qli/Kaanapali qli/MAHUA qli/X1E80100 qli/nord qli/shikra_cqs qli/shikra_iqs qli/HAWI qli/arduino_monza
+SUBDIRS = qli/qcm6490 qli/qcs615 qli/qcs8275 qli/qcs8300 qli/qcs9100 qli/qcs9075 qli/sm8750 qli/eliza qli/GLYMUR qli/Kaanapali qli/MAHUA qli/X1E80100 qli/nord qli/shikra_cqs qli/shikra_iqs qli/HAWI qli/arduino_monza
diff --git a/qcom/qli/configure.ac b/qcom/qli/configure.ac
index 75c8b26..dc8c5da 100644
--- a/qcom/qli/configure.ac
+++ b/qcom/qli/configure.ac
@@ -48,7 +48,8 @@ AC_CONFIG_FILES([ \
     shikra_cqs/Makefile shikra_cqs/config.pc \
     shikra_iqs/Makefile shikra_iqs/config.pc \
     HAWI/Makefile \
-    arduino_monza/Makefile
+    arduino_monza/Makefile \
+    eliza/Makefile eliza/config.pc
     ])
 
 AC_OUTPUT
diff --git a/qcom/qli/eliza/Makefile.am b/qcom/qli/eliza/Makefile.am
new file mode 100644
index 0000000..e7decf8
--- /dev/null
+++ b/qcom/qli/eliza/Makefile.am
@@ -0,0 +1,16 @@
+pkgconfigdir = $(libdir)/pkgconfig
+pkgconfig_DATA = config.pc
+EXTRA_DIST = $(pkgconfig_DATA)
+
+AM_CFLAGS = -Wall -Werror
+
+config_acdbdata = acdbdata/acdb_cal.acdb\
+		 acdbdata/workspaceFileXml.qwsp
+
+config_acdbdatadir = $(sysconfdir)/acdbdata/eliza_cqs_evk/
+config_acdbdata_DATA = $(config_acdbdata)
+
+config_carddef = card-defs.xml
+
+config_carddefdir = $(sysconfdir)
+config_carddef_DATA = $(config_carddef)
diff --git a/qcom/qli/eliza/acdbdata/acdb_cal.acdb b/qcom/qli/eliza/acdbdata/acdb_cal.acdb
new file mode 100644
