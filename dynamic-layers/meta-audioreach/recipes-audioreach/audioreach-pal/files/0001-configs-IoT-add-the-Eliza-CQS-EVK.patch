From fe98a85c658543257ebee9230eb4e236b453fe17 Mon Sep 17 00:00:00 2001
From: Tyler Baker <tyler.baker@oss.qualcomm.com>
Date: Sun, 8 Nov 2026 00:54:31 +0000
Subject: [PATCH] configs: IoT: add the Eliza CQS EVK

PAL init fails on "eliza-cqs-evk": no resourcemanager or mixer_paths.
Add both from SM8750 MTP, cut down to what the Eliza card has: two
WSA8845 on WSA RX0, DMICs on VA TX0.

Signed-off-by: Tyler Baker <tyler.baker@oss.qualcomm.com>
Upstream-Status: Submitted [https://github.com/AudioReach/audioreach-pal/pull/117]
---
 Makefile.am                                   |   6 +-
 .../IoT/eliza/mixer_paths_eliza_cqs_evk.xml   | 288 +++++++++++++++
 .../eliza/resourcemanager_eliza_cqs_evk.xml   | 345 ++++++++++++++++++
 3 files changed, 638 insertions(+), 1 deletion(-)
 create mode 100644 configs/qcom/IoT/eliza/mixer_paths_eliza_cqs_evk.xml
 create mode 100644 configs/qcom/IoT/eliza/resourcemanager_eliza_cqs_evk.xml

diff --git a/Makefile.am b/Makefile.am
index 66c5e39c..ddc94895 100644
--- a/Makefile.am
+++ b/Makefile.am
@@ -162,7 +162,9 @@ libpal_la_list      = ./configs/qcom/IoT/qcm6490/usecaseKvManager.xml \
                       ./configs/qcom/IoT/HAWI/mixer_paths_HAWI_MTP.xml \
                       ./configs/qcom/IoT/HAWI/resourcemanager_HAWI_MTP.xml \
                       ./configs/qcom/IoT/arduino_monza/mixer_paths_arduino_monza.xml \
-                      ./configs/qcom/IoT/arduino_monza/resourcemanager_arduino_monza.xml
+                      ./configs/qcom/IoT/arduino_monza/resourcemanager_arduino_monza.xml \
+                      ./configs/qcom/IoT/eliza/mixer_paths_eliza_cqs_evk.xml \
+                      ./configs/qcom/IoT/eliza/resourcemanager_eliza_cqs_evk.xml
 
 
 # install essential xml files under /etc
@@ -205,6 +207,8 @@ install-data-hook:
 	chmod  go+r $(DESTDIR)$(root_etcdir)/resourcemanager_arduino_monza.xml
 	ln -sf mixer_paths_arduino_monza.xml $(DESTDIR)$(root_etcdir)/mixer_paths_monaco_gertrude.xml
 	ln -sf resourcemanager_arduino_monza.xml $(DESTDIR)$(root_etcdir)/resourcemanager_monaco_gertrude.xml
+	chmod  go+r $(DESTDIR)$(root_etcdir)/mixer_paths_eliza_cqs_evk.xml
+	chmod  go+r $(DESTDIR)$(root_etcdir)/resourcemanager_eliza_cqs_evk.xml
 endif
 
 if COMPILE_ADSPRPCD
diff --git a/configs/qcom/IoT/eliza/mixer_paths_eliza_cqs_evk.xml b/configs/qcom/IoT/eliza/mixer_paths_eliza_cqs_evk.xml
