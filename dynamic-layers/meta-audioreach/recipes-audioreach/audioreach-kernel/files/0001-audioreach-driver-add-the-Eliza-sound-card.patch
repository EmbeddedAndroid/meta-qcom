From 78051a102f74c2d1780ab8376b5fbfbb83da6726 Mon Sep 17 00:00:00 2001
From: Tyler Baker <tyler.baker@oss.qualcomm.com>
Date: Sun, 8 Nov 2026 00:54:31 +0000
Subject: [PATCH] audioreach-driver: add the Eliza sound card

Eliza's DT card is "qcom,eliza-sndcard" with an sm8450 fallback. With
no Eliza entry it binds as "sm8450", so UCM and PAL look up the wrong
platform.

Add an entry with driver name "eliza". Eliza has the SM8750 audio
layout (two WSA884x, WCD jack), so reuse the SM8750 data, including
the shared qcs6490_* widget tables that SM8450 through SM8750 use.

Signed-off-by: Tyler Baker <tyler.baker@oss.qualcomm.com>
Upstream-Status: Submitted [https://github.com/AudioReach/audioreach-kernel/pull/92]
---
 audioreach-driver/audioreach_common.c | 11 +++++++++++
 1 file changed, 11 insertions(+)

diff --git a/audioreach-driver/audioreach_common.c b/audioreach-driver/audioreach_common.c
index a7b0b6d..bc0ae22 100644
--- a/audioreach-driver/audioreach_common.c
+++ b/audioreach-driver/audioreach_common.c
@@ -1268,6 +1268,16 @@ static struct snd_soc_common sm8750_priv_data = {
 	.wcd_jack = true,
 };
 
+static struct snd_soc_common eliza_priv_data = {
+	.driver_name = "eliza",
+	.dapm_widgets = qcs6490_dapm_widgets,
+	.num_dapm_widgets = ARRAY_SIZE(qcs6490_dapm_widgets),
+	.dapm_routes = qcs6490_dapm_routes,
+	.num_dapm_routes = ARRAY_SIZE(qcs6490_dapm_routes),
+	.num_wsa_spkr = 2,
+	.wcd_jack = true,
+};
+
 static struct snd_soc_common x1e80100_priv_data = {
 	.driver_name = "x1e80100",
 	.dapm_widgets = glymur_dapm_widgets,
@@ -1290,6 +1300,7 @@ static const struct snd_soc_common hawi_priv_data = {
 };
 
 static const struct of_device_id snd_qcs6490_dt_match[] = {
+	{.compatible = "qcom,eliza-sndcard", .data = &eliza_priv_data},
 	{.compatible = "qcom,glymur-sndcard", .data = &glymur_priv_data},
 	{.compatible = "qcom,hawi-sndcard", .data = &hawi_priv_data},
 	{.compatible = "qcom,kaanapali-sndcard", .data = &kaanapali_priv_data},
